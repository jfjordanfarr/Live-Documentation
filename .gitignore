# Node/TypeScript workspace artifacts
node_modules/
dist/
build/
out/
coverage/
*.log
*.tsbuildinfo

# Environment and secrets
.env
.env.*
*.local

# OS/editor cruft
.DS_Store
Thumbs.db
.vscode/
.idea/

# SQLite caches
*.sqlite
*.sqlite-journal
*.db-shm
*.db-wal

# DB files
*.db

# Prevent accidental compiled JS artifacts in TypeScript source folders
packages/**/src/**/*.js
packages/**/src/**/*.js.map
packages/**/src/**/*.d.ts
packages/**/src/**/*.d.ts.map

# Ignore compiled helper outputs under scripts
scripts/**/lib/**/*.js
scripts/**/lib/**/*.js.map
scripts/**/lib/**/*.d.ts
scripts/**/lib/**/*.d.ts.map

# Local lint outputs (ensure clean repo)
eslint-report.json
lint-output.txt

# Ignore generated MDMD signal scaffolding
AI-Agent-Workspace/ChatHistory/MDMD-Signals/

# Ignore transient agent workspace scratch directories
**/AI-Agent-Workspace/tmp/
AI-Agent-Workspace/ollama-traces/

# Ignore generated Playwright MCP assets
.playwright-mcp/

# Playwright E2E test artifacts
test-results/
reports/e2e/

# Live Documentation staging outputs

# SCIP index files and the build artifacts the SCIP indexers leave behind
*.scip
**/obj/
**/target/
**/bin/