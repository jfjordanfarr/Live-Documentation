{
  "name": "@live-documentation/explorer",
  "version": "0.0.0",
  "private": true,
  "description": "The Live Documentation Explorer: the static bundle builder and the browser client.",
  "license": "MIT",
  "author": "Jordan Farr <jfjordanfarr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfjordanfarr/Live-Documentation.git",
    "directory": "packages/explorer"
  },
  "type": "commonjs",
  "files": [
    "dist"
  ],
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc --noEmit -p src/client/tsconfig.json"
  },
  "dependencies": {
    "@live-documentation/engine": "file:../engine",
    "3d-force-graph": "^1.80.0",
    "d3-force-3d": "^3.0.6",
    "esbuild": "^0.28.2",
    "jszip": "^3.10.1",
    "lz-string": "^1.5.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/three": "^0.186.0"
  }
}
