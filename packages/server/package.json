{
  "name": "@live-documentation/server",
  "version": "0.0.0",
  "private": true,
  "description": "The Live Documentation generator: analyzes a workspace and writes one markdown file per source file.",
  "license": "MIT",
  "author": "Jordan Farr <jfjordanfarr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfjordanfarr/Live-Documentation.git",
    "directory": "packages/server"
  },
  "type": "commonjs",
  "main": "dist/features/live-docs/generator.js",
  "types": "dist/features/live-docs/generator.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@live-documentation/shared": "file:../shared"
  }
}
