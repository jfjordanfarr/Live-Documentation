{
  "name": "@live-documentation/scripts",
  "version": "0.0.0",
  "private": true,
  "description": "Build and analysis scripts for Live Documentation.",
  "license": "MIT",
  "author": "Jordan Farr <jfjordanfarr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfjordanfarr/Live-Documentation.git",
    "directory": "packages/scripts"
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@live-documentation/shared": "file:../shared",
    "esbuild": "^0.27.3",
    "glob": "^13.0.6",
    "jszip": "^3.10.1"
  }
}
