{
  "name": "live-documentation",
  "displayName": "Live Documentation",
  "description": "Mirrors your codebase into deterministic, machine-verified markdown. Offline-first documentation that lives in your repo.",
  "publisher": "live-documentation",
  "version": "0.0.0",
  "license": "MIT",
  "author": "Jordan Farr <jfjordanfarr@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfjordanfarr/Live-Documentation.git",
    "directory": "packages/extension"
  },
  "homepage": "https://github.com/jfjordanfarr/Live-Documentation#readme",
  "bugs": {
    "url": "https://github.com/jfjordanfarr/Live-Documentation/issues"
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "liveDocumentation.isServerReady",
        "title": "Live Documentation: Server Ready",
        "icon": "$(debug-start)"
      }
    ],
    "configuration": {
      "title": "Live Documentation",
      "properties": {
        "liveDocumentation.storagePath": {
          "type": "string",
          "default": "",
          "description": "Optional override for the on-disk storage path."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch"
  },
  "dependencies": {
    "@live-documentation/shared": "file:../shared",
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@types/vscode": "^1.109.0"
  }
}
