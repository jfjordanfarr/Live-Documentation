<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="PaymentsDb"
         connectionString="Server=sql.onprem.example;Database=Payments;Integrated Security=true"
         providerName="System.Data.SqlClient" />
  </connectionStrings>
  <system.serviceModel>
    <services>
      <service name="Estate.Payments.PaymentService">
        <endpoint address="net.tcp://payments.onprem.example:8732/PaymentService"
                  binding="netTcpBinding" contract="Estate.Contracts.IPaymentService" />
      </service>
    </services>
  </system.serviceModel>
</configuration>
