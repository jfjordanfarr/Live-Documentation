<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Gateway.Workload"    value="Consumer" />
    <add key="Gateway.Environment" value="Production" />
  </appSettings>
  <system.serviceModel>
    <bindings>
      <netTcpBinding>
        <binding name="HubBinding" />
      </netTcpBinding>
    </bindings>
    <client>
      <!-- Reached over the IPSEC tunnel from the cloud into the on-prem network. -->
      <endpoint name="PaymentHub"
                address="net.tcp://hub.onprem.example:8731/PaymentHub"
                binding="netTcpBinding" bindingConfiguration="HubBinding"
                contract="Estate.Contracts.IPaymentHub" />
    </client>
  </system.serviceModel>
</configuration>
