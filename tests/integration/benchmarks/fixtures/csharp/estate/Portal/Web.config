<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="Portal.GatewayBaseUrl"  value="https://gateway.cloud.example/" />
    <add key="Portal.PaymentsEnabled" value="true" />
  </appSettings>
  <system.web>
    <compilation targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" />
  </system.web>
</configuration>
