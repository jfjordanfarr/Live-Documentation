<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.serviceModel>
    <services>
      <service name="Estate.Hub.PaymentHub">
        <endpoint address="net.tcp://hub.onprem.example:8731/PaymentHub"
                  binding="netTcpBinding" contract="Estate.Contracts.IPaymentHub" />
      </service>
    </services>
    <client>
      <!-- One endpoint per workload and environment; ServiceRouting builds the name. -->
      <endpoint name="PaymentService.Consumer.Production"
                address="net.tcp://payments.onprem.example:8732/PaymentService"
                binding="netTcpBinding" contract="Estate.Contracts.IPaymentService" />
      <endpoint name="PaymentService.Consumer.Staging"
                address="net.tcp://payments-staging.onprem.example:8732/PaymentService"
                binding="netTcpBinding" contract="Estate.Contracts.IPaymentService" />
    </client>
  </system.serviceModel>
</configuration>
