{
  "root": ".mdmd",
  "baseLayer": "layer-4",
  "extension": ".mdmd.md",
  "board": ".mdmd/layer-3/board.mdmd.md",
  "sampleRoots": ["tests/integration/programs", "tests/integration/fixtures"],
  "entryPoints": ["packages/explorer/src/client/index.ts", "packages/explorer/src/client/styles.css"],
  "exclude": ["AI-Agent-Workspace/**"],
  "bundleExclude": [
    "AI-Agent-Workspace/ChatHistory/**/!(*.SUMMARIZED).md",
    "AI-Agent-Workspace/ChatHistory/**/*.txt",
    "AI-Agent-Workspace/AgentSessionHistory/*.{md,txt}",
    "AI-Agent-Workspace/AgentSessionHistory/*/*/*.{md,txt}",
    "AI-Agent-Workspace/AgentSessionHistory/*/*/Summarized/**/!(*.SUMMARIZED).md",
    "AI-Agent-Workspace/AgentSessionHistory/*/*/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/*.{md,txt}",
    "AI-Agent-Workspace/AgentSessionHistory/*/*/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/!(Probes|Research|Screenshots)/**/*.{md,txt}"
  ]
}
