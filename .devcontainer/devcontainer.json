// Live Documentation Development Container
// =========================================
// This devcontainer provides a fully-configured Linux environment for
// developing and testing Live Documentation, including all SCIP indexers
// needed for compiler-backed benchmark fixture generation.
//
// Works identically in:
//   - VS Code Dev Containers (local Docker)
//   - GitHub Codespaces (cloud)
//
// For usage instructions, see .devcontainer/README.md
{
  "name": "Live Documentation Dev",

  // Base image: Node.js 22 (matches our .nvmrc)
  // Using the official Microsoft devcontainers image for best Codespaces compatibility
  "image": "mcr.microsoft.com/devcontainers/typescript-node:22",

  // Language toolchains installed via official devcontainer features
  // These are the same features GitHub Codespaces uses internally
  // See: https://containers.dev/features
  "features": {
    // .NET 10 (current LTS, released Nov 2025, support until Nov 2028)
    // Used by: scip-dotnet for C# fixture indexing
    "ghcr.io/devcontainers/features/dotnet:2": {
      "version": "10.0"
    },

    // Java 21 (LTS) with Maven and Gradle
    // Used by: scip-java for Java/Kotlin fixture indexing
    "ghcr.io/devcontainers/features/java:1": {
      "version": "21",
      "installMaven": true,
      "installGradle": true
    },

    // Go (latest stable)
    // Used by: scip-go for Go fixture indexing
    "ghcr.io/devcontainers/features/go:1": {
      "version": "latest"
    },

    // Python 3.12
    // Used by: scip-python for Python fixture indexing
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    },

    // Rust (stable toolchain)
    // Used by: rust-analyzer for Rust fixture indexing
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable"
    },

    // PowerShell 7+
    // Used by: oracle:index, whose PowerShell parser measures the PowerShell adapter (development only)
    "ghcr.io/devcontainers/features/powershell:1": {
      "version": "latest"
    },

    // GitHub CLI for repository operations
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },

  // The coding agents' own folders on named volumes, so that rebuilding the container keeps their sign-ins, settings
  // and past chats, which otherwise live in the container's own layer and go with it (2026-11-17). A named volume is
  // plain Docker: it is created empty on first use on any host, GitHub Codespaces included, and someone who uses
  // neither agent never notices the two. CLAUDE_CONFIG_DIR is Claude Code's own setting for keeping the one file it
  // writes beside its folder (~/.claude.json) inside the folder, and so on the volume. A fresh volume is mounted as
  // root's, so the first command hands the folders to the container's user before an editor attaches.
  //
  // The third volume holds node_modules on the container's own disk. Where the workspace is a Windows folder, every
  // file a tool opens there costs a round trip to Windows, 4 to 6 ms each against 0.01 ms on the container's disk
  // (measured 2026-11-17), and a tool's start is thousands of them in node_modules: the browser tests took 54 s to
  // find their cases and 5 s with the dependencies on the container's disk. Its name carries the container's
  // identity, since its content belongs to one checkout; post-create.sh fills it with "npm install". The folder of
  // the same name on the host stays as it was and is not used.
  "mounts": [
    "source=live-documentation-claude,target=/home/node/.claude,type=volume",
    "source=live-documentation-codex,target=/home/node/.codex,type=volume",
    "source=live-documentation-node-modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CONFIG_DIR": "/home/node/.claude"
  },
  "onCreateCommand": "sudo chown node:node /home/node/.claude /home/node/.codex ${containerWorkspaceFolder}/node_modules",

  // Post-creation setup: install npm dependencies and SCIP indexers
  "postCreateCommand": "bash .devcontainer/post-create.sh",

  // VS Code / Codespaces customizations
  "customizations": {
    "vscode": {
      "extensions": [
        // Core development
        "dbaeumer.vscode-eslint",
        "ms-vscode.vscode-typescript-next",

        // GitHub Copilot
        "GitHub.copilot",
        "GitHub.copilot-chat",

        // Language support (for benchmark fixture editing)
        "ms-dotnettools.csharp",
        "golang.go",
        "ms-python.python",
        "rust-lang.rust-analyzer",
        "redhat.java"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        // Nothing formats TypeScript here: hand-aligned whitespace stays as written, and lint enforces correctness
        // alone (the owner, 2026-09-27 and 2026-10-22; the decision of 2026-10-22 in the decisions log).
        "editor.formatOnSave": false,
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    },

    // Codespaces-specific settings
    "codespaces": {
      // Open these files automatically when codespace starts
      "openFiles": [
        "README.md",
        ".devcontainer/README.md"
      ]
    }
  },

  // Machine requirements for GitHub Codespaces
  // 4-core recommended for benchmark regeneration (SCIP indexing is CPU-intensive)
  "hostRequirements": {
    "cpus": 8,
    "memory": "32gb",
    "storage": "32gb"
  },

  // Workspace mount configuration for better performance
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/${localWorkspaceFolderBasename},type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Run as non-root user (standard devcontainer practice)
  "remoteUser": "node"
}
