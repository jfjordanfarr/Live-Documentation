{
  "name": "live-documentation",
  "version": "0.0.0",
  "private": true,
  "description": "Mirrors your codebase into deterministic, machine-verified markdown. Offline-first documentation that lives in your repo.",
  "keywords": [
    "documentation",
    "markdown",
    "ast",
    "code-analysis",
    "dependency-graph",
    "typescript",
    "polyglot",
    "offline-first",
    "cli"
  ],
  "homepage": "https://github.com/jfjordanfarr/Live-Documentation#readme",
  "bugs": {
    "url": "https://github.com/jfjordanfarr/Live-Documentation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfjordanfarr/Live-Documentation.git"
  },
  "license": "MIT",
  "author": "Jordan Farr <jfjordanfarr@gmail.com>",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/engine",
    "packages/generator",
    "packages/explorer",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build -w packages/engine && npm run build -w packages/explorer && npm run build -w packages/generator",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "pretest:e2e": "npm run live-docs:visualize && npm run live-docs:visualize:estate",
    "test:e2e": "npm run live-docs:visualize && npm run live-docs:visualize:estate && npx playwright test --config tests/e2e/playwright.config.ts",
    "verify": "node ./scripts/verify.mjs",
    "safe:commit": "node ./scripts/safe-to-commit.mjs",
    "docs:links:enforce": "tsx --tsconfig ./tsconfig.base.json scripts/doc-tools/enforce-documentation-links.ts",
    "slopcop:markdown": "tsx --tsconfig ./tsconfig.base.json scripts/slopcop/check-markdown-links.ts",
    "slopcop:assets": "tsx --tsconfig ./tsconfig.base.json scripts/slopcop/check-asset-paths.ts",
    "slopcop:symbols": "tsx --tsconfig ./tsconfig.base.json scripts/slopcop/check-symbols.ts",
    "livedocs": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/run-all.ts",
    "live-docs:generate": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/generate.ts --config ./.live-docs.config.json",
    "live-docs:lint": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/lint.ts --config ./.live-docs.config.json",
    "live-docs:inspect": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/inspect.ts --config ./.live-docs.config.json",
    "live-docs:board": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/board.ts --config ./.live-docs.config.json",
    "live-docs:visualize": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/visualize-static.ts --config ./.live-docs.config.json --board .mdmd/layer-3/board.mdmd.md",
    "live-docs:visualize:estate": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/visualize-sample.ts --program tests/integration/programs/csharp/estate --board board.md --output dist/explorer/samples/estate",
    "oracle:index": "tsx --tsconfig ./tsconfig.base.json scripts/oracle/index-fixture.ts",
    "oracle:compare": "tsx --tsconfig ./tsconfig.base.json scripts/oracle/compare.ts",
    "live-docs:orphans": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/find-orphans.ts --docs-root .mdmd --base-layer layer-4",
    "ci-check": "node ./scripts/safe-to-commit.mjs --skip-git-status"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@sourcegraph/scip-typescript": "^0.4.0",
    "@types/node": "^25.3.2",
    "@typescript-eslint/eslint-plugin": "^8.57.0",
    "@typescript-eslint/parser": "^8.57.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@vscode/tree-sitter-wasm": "^0.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-jsdoc": "^62.7.1",
    "glob": "^13.0.6",
    "prettier": "^3.8.1",
    "tsx": "^4.23.15",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.57.0",
    "vitest": "^4.1.11"
  }
}
