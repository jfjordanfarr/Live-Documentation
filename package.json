{
  "name": "live-documentation",
  "version": "0.0.0",
  "private": true,
  "description": "Mirrors your codebase into deterministic, machine-verified markdown. Offline-first documentation that lives in your repo.",
  "keywords": [
    "documentation",
    "markdown",
    "ast",
    "code-analysis",
    "dependency-graph",
    "typescript",
    "polyglot",
    "offline-first",
    "vscode-extension",
    "cli"
  ],
  "homepage": "https://github.com/jfjordanfarr/Live-Documentation#readme",
  "bugs": {
    "url": "https://github.com/jfjordanfarr/Live-Documentation/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jfjordanfarr/Live-Documentation.git"
  },
  "license": "MIT",
  "author": "Jordan Farr <jfjordanfarr@gmail.com>",
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/extension",
    "packages/server",
    "packages/shared",
    "packages/scripts",
    "packages/cli",
    "packages/testing"
  ],
  "scripts": {
    "build": "npm run build -w packages/shared && npm run build -w packages/scripts && npm run build -w packages/server && npm run compile -w packages/extension",
    "lint": "eslint .",
    "format": "prettier --check .",
    "test:unit": "vitest run",
    "test:integration": "node ./tests/integration/clean-dist.mjs && npm run build && tsc -p tests/integration/tsconfig.json && node ./tests/integration/dist/vscode/runTests.js",
    "test:benchmarks": "node ./scripts/run-benchmarks.mjs",
    "verify": "node ./scripts/verify.mjs",
    "safe:commit": "node ./scripts/safe-to-commit.mjs",
    "fixtures:verify": "tsx --tsconfig ./tsconfig.base.json scripts/fixture-tools/verify-fixtures.ts",
    "fixtures:update-hashes": "tsx --tsconfig ./tsconfig.base.json scripts/fixture-tools/update-fixture-hashes.ts",
    "fixtures:record-fallback": "tsx --tsconfig ./tsconfig.base.json scripts/fixture-tools/record-fallback-inference.ts",
    "fixtures:regenerate": "tsx --tsconfig ./tsconfig.base.json scripts/fixture-tools/regenerate-benchmarks.ts",
    "fixtures:sync-docs": "tsx --tsconfig ./tsconfig.base.json scripts/fixture-tools/sync-ast-doc.ts",
    "docs:links:enforce": "tsx --tsconfig ./tsconfig.base.json scripts/doc-tools/enforce-documentation-links.ts",
    "slopcop:markdown": "tsx --tsconfig ./tsconfig.base.json scripts/slopcop/check-markdown-links.ts",
    "slopcop:assets": "tsx --tsconfig ./tsconfig.base.json scripts/slopcop/check-asset-paths.ts",
    "slopcop:symbols": "tsx --tsconfig ./tsconfig.base.json scripts/slopcop/check-symbols.ts",
    "tech-debt": "tsx --tsconfig ./tsconfig.base.json scripts/analysis/tech-debt-detector.ts",
    "audit:network": "tsx --tsconfig ./tsconfig.base.json scripts/analysis/audit-network-usage.ts",
    "livedocs": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/run-all.ts",
    "live-docs:generate": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/generate.ts --config ./.live-docs.config.json",
    "live-docs:system": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/system.ts --config ./.live-docs.config.json",
    "live-docs:headless": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/headless.ts",
    "live-docs:lint": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/lint.ts --config ./.live-docs.config.json",
    "live-docs:targets": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/build-target-manifest.ts",
    "live-docs:report": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/report-precision.ts",
    "live-docs:inspect": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/inspect.ts --config ./.live-docs.config.json",
    "live-docs:visualize": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/visualize-explorer.ts --config ./.live-docs.config.json",
    "live-docs:visualize:static": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/visualize-static.ts --config ./.live-docs.config.json",
    "live-docs:co-activation": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/co-activation.ts",
    "live-docs:orphans": "tsx --tsconfig ./tsconfig.base.json scripts/live-docs/find-orphans.ts",
    "test:contracts": "npm run test:contracts -w packages/server",
    "ci-check": "node ./scripts/safe-to-commit.mjs --skip-git-status"
  },
  "devDependencies": {
    "@sourcegraph/scip-typescript": "^0.4.0",
    "@types/better-sqlite3": "^7.6.10",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "@vitest/coverage-v8": "^4.0.16",
    "@vscode/test-electron": "^2.3.7",
    "@vscode/tree-sitter-wasm": "^0.3.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.29.1",
    "glob": "^13.0.0",
    "mocha": "^11.7.5",
    "prettier": "^3.7.4",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "typescript-eslint": "^8.51.0",
    "vitest": "^4.0.9"
  }
}
