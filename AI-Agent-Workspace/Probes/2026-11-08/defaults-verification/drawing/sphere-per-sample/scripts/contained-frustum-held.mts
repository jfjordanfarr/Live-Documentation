import{chromium}from'@playwright/test';import{readFile,writeFile}from'node:fs/promises';import{observeGraph}from'../../tests/e2e/force-graph-observation.ts';import{PERSISTED_UI_KEY}from'../../packages/explorer/src/client/persistence/local-storage.ts';
const out='/tmp/live-docs-20261108-defaults-diagnostics',browser=await chromium.launch({headless:true}),ctx=await browser.newContext({viewport:{width:1280,height:800}}),page=await ctx.newPage(),report:any={poses:[],errors:[],heldMotion:true};
try{
 const body=await readFile(out+'/frustum-held.js','utf8');await page.route('**/static/index.js',route=>route.fulfill({body,contentType:'application/javascript'}));await page.addInitScript({content:'globalThis.__name=value=>value;'});await page.addInitScript(key=>localStorage.setItem(key,JSON.stringify({version:2,tuning:{localMap:{searchStarts:0}}})),PERSISTED_UI_KEY);await observeGraph(page);page.on('pageerror',e=>report.errors.push(String(e)));page.on('console',m=>{if(m.type()==='error')report.errors.push(m.text());});
 await page.goto('http://localhost:8911/?view=local&mode=3d&node=packages%2Fgenerator%2Fsrc%2Fgenerator.ts');
 for(const target of [110,250]){
  await page.waitForFunction(target=>{const state=(window as any).frustumRevision?.();return state&&state.revision>=target&&state.revealed===state.total&&!state.packing;},target,{timeout:60000});
  const pose:any=await page.evaluate(()=>{const w=window as any;w.__heldFrustumPose=true;const{renderer,scene,camera}=w.renderedGraph,mesh=scene.getObjectByName('Spatial shell files');w.__frustumBefore=w.frustumMaterials.before();w.__frustumAfter=w.frustumMaterials.after();w.__frustumPixels=()=>{renderer.render(scene,camera);const gl=renderer.getContext(),data=new Uint8Array(renderer.domElement.width*renderer.domElement.height*4);gl.readPixels(0,0,renderer.domElement.width,renderer.domElement.height,gl.RGBA,gl.UNSIGNED_BYTE,data);return data;};return{...w.frustumRevision(),unitCount:mesh.count,matrices:[...mesh.instanceMatrix.array.slice(0,16*mesh.count)],camera:[...camera.matrixWorld.elements],projection:[...camera.projectionMatrix.elements],modes:[]};});
  for(const mode of ['before','after','before']){
   await page.evaluate(mode=>{const w=window as any;w.renderedGraph.scene.getObjectByName('Spatial shell files').material=mode==='before'?w.__frustumBefore:w.__frustumAfter;w.__frustumPixels();},mode);
   const start=await page.evaluate(()=>({at:performance.now(),frames:(window as any).renderedFrames}));await page.waitForTimeout(4000);
   const result=await page.evaluate(({mode,first})=>{const w=window as any,{renderer}=w.renderedGraph,data=w.__frustumPixels();let changed=0,max=0;if(first)w.__frustumBaseline=data;else for(let i=0;i<data.length;i++){const delta=Math.abs(data[i]-w.__frustumBaseline[i]);if(delta)changed++;max=Math.max(max,delta);}return{at:performance.now(),frames:w.renderedFrames,drawn:{...renderer.info.render},changedChannels:changed,maxDifference:max,png:renderer.domElement.toDataURL('image/png')};},{mode,first:pose.modes.length===0});
   const suffix=pose.modes.length===2?'restored':mode;await writeFile(out+`/frustum-held-${target}-${suffix}.png`,Buffer.from(result.png.split(',')[1],'base64'));delete result.png;pose.modes.push({mode,elapsedMs:result.at-start.at,draws:result.frames-start.frames,fps:1000*(result.frames-start.frames)/(result.at-start.at),...result});
  }
  report.poses.push(pose);console.log(JSON.stringify({...pose,matrices:undefined}));await writeFile(out+'/frustum-held-comparison.json',JSON.stringify(report,null,2)+'\n');await page.evaluate(()=>{(window as any).__heldFrustumPose=false;(window as any).renderedGraph.scene.getObjectByName('Spatial shell files').material=(window as any).__frustumAfter;});
 }
}finally{await writeFile(out+'/frustum-held-comparison.json',JSON.stringify(report,null,2)+'\n');await ctx.close();await browser.close();}
