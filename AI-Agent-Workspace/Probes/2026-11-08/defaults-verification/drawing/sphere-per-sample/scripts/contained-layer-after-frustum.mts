import{chromium}from'@playwright/test';import{readFile,writeFile}from'node:fs/promises';import{observeGraph}from'../../tests/e2e/force-graph-observation.ts';import{PERSISTED_UI_KEY}from'../../packages/explorer/src/client/persistence/local-storage.ts';
