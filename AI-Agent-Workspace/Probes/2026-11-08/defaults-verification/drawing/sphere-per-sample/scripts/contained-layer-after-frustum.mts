 report.pose=await page.evaluate(()=>{const w=window as any;w.__heldFrustumPose=true;const{renderer,scene,camera}=w.renderedGraph;w.__layerMeshes=['Spatial nodes','Spatial shell balloons','Spatial shell files'].map(name=>scene.getObjectByName(name));w.__layerVisibility=w.__layerMeshes.map((m:any)=>m.visible);w.__layerPixels=()=>{renderer.render(scene,camera);const gl=renderer.getContext(),data=new Uint8Array(renderer.domElement.width*renderer.domElement.height*4);gl.readPixels(0,0,renderer.domElement.width,renderer.domElement.height,gl.RGBA,gl.UNSIGNED_BYTE,data);return data;};return{...w.frustumRevision(),camera:[...camera.matrixWorld.elements],projection:[...camera.projectionMatrix.elements],canvas:{width:renderer.domElement.width,height:renderer.domElement.height,dpr:devicePixelRatio},counts:w.__layerMeshes.map((m:any)=>({name:m.name,count:m.count,visible:m.visible,vertices:m.geometry.getAttribute('position').count,material:m.material.type}))};});
 for(const mode of ['baseline','without-nodes','restored-nodes','without-balloons','restored-balloons','without-files','restored-files']){
