try{
 await page.goto('http://localhost:8911/samples/estate/?view=local&dir=Portal&layout=structure'+(nativeOnly?'&mode=3d':''));if(nativeOnly)await expect(page.locator('#graph-svg')).toHaveAttribute('aria-busy','false',{timeout:25000});else await localMapStill(page);await picture(nativeOnly?'source-native-3d':'source-2d');
 const initial=decompressSnapshot(new URL(page.url()).searchParams.get('s')??'');report.initial={pins:initial.pinSet,opens:[...initial.openDirectories]};
 if(!nativeOnly){await transition('3D','skin-out');
 await gesture('left',75,25);await picture('skin-orbit');await gesture('right',50,-20);await picture('skin-pan');const p=await background(),before=await camera();await page.mouse.wheel(0,-180);await expect.poll(async()=>JSON.stringify(await camera())).not.toBe(JSON.stringify(before));await cameraStill();await picture('skin-zoom');
 await transition('2D','skin-back');await transition('3D','skin-warm-out');await wrappers('cloud');await picture('cloud');await transition('2D','cloud-back');await transition('3D','cloud-out');await wrappers('skin');}
 // Explicit near-plane diagnostic: retain the live camera pose, normal clock and submitted contents; move only the clip plane.
 report.clip=await page.evaluate(()=>{const w=window as any,{scene,camera}=w.renderedGraph,mesh=scene.getObjectByName('Spatial shell files'),m=camera.matrixWorld.clone();const candidates=[];
 for(let slot=0;slot<mesh.count;slot++){mesh.getMatrixAt(slot,m);m.premultiply(mesh.matrixWorld);const center=camera.position.clone().set(m.elements[12],m.elements[13],m.elements[14]),view=center.clone().applyMatrix4(camera.matrixWorldInverse),r=Math.hypot(m.elements[0],m.elements[1],m.elements[2]),projected=center.clone().project(camera);if(-view.z>r&&Math.abs(projected.x)<.8&&Math.abs(projected.y)<.8)candidates.push({id:mesh.userData.spatialUnits[slot].id,slot,depth:-view.z,radius:r,size:r/-view.z});}
 candidates.sort((a,b)=>b.size-a.size);const target=candidates[0];if(!target)throw Error('No visible contained mark for clipping diagnostic');const previousNear=camera.near;camera.near=target.depth-.9*target.radius;camera.updateProjectionMatrix();const screen=camera.position.clone().set(m.elements[12],m.elements[13],m.elements[14]);mesh.getMatrixAt(target.slot,m);screen.set(m.elements[12],m.elements[13],m.elements[14]).project(camera);return{...target,previousNear,near:camera.near,controlledProjection:true,motionPaused:false,material:mesh.material.type,geometryVertices:mesh.geometry.getAttribute("position").count};});
 await page.evaluate(()=>new Promise<void>(resolve=>requestAnimationFrame(()=>requestAnimationFrame(()=>resolve()))));await picture('clip-source');await transition('2D','clip-back');
 await page.evaluate(near=>{const c=(window as any).renderedGraph.camera;c.near=near;c.updateProjectionMatrix();},report.clip.previousNear);
 const returned=decompressSnapshot(new URL(page.url()).searchParams.get('s')??'');report.returned={pins:returned.pinSet,opens:[...returned.openDirectories]};expect(report.returned).toEqual(report.initial);
 console.log(JSON.stringify(report));
}finally{await writeFile(out+'/motion.json',JSON.stringify(report,null,2)+'\n');await ctx.close();await browser.close();}
