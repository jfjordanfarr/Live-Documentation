await page.addInitScript({content:'globalThis.__name=value=>value;'});await page.addInitScript(key=>localStorage.setItem(key,JSON.stringify({version:2,tuning:{localMap:{searchStarts:0}}})),PERSISTED_UI_KEY);if(nativeOnly)await page.addInitScript(()=>{const original=WebGL2RenderingContext.prototype.getExtension;WebGL2RenderingContext.prototype.getExtension=function(name:string){return name==='OES_sample_variables'||name==='OES_shader_multisample_interpolation'?null:original.call(this,name);};});await observeGraph(page);page.on('pageerror',e=>report.errors.push(String(e)));
