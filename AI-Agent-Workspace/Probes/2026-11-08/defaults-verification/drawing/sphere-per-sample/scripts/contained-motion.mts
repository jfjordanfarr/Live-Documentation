async function cameraStill(){
 const projected=()=>page.evaluate(()=>{const{camera,renderer}=(window as any).renderedGraph,v=camera.position.clone(),points=[];for(const [x,y,z]of [[0,0,0],[100,0,0],[0,100,0],[0,0,100]]){v.set(x,y,z).project(camera);points.push(v.x*renderer.domElement.width/2,v.y*renderer.domElement.height/2);}return points;});
 let previous=await projected(),samples=0;await expect.poll(async()=>{const next=await projected();samples=next.every((v:number,i:number)=>Math.abs(v-previous[i])<.1)?samples+1:0;previous=next;return samples;},{intervals:[100],timeout:5000}).toBeGreaterThanOrEqual(3);
}
async function background(){const b=(await page.locator('#graph-svg canvas').boundingBox())!;for(const[fx,fy]of [[.85,.75],[.15,.75],[.85,.2],[.15,.2],[.5,.15],[.9,.5]]){const p={x:b.x+b.width*fx,y:b.y+b.height*fy};if(!await page.evaluate(p=>document.elementFromPoint(p.x,p.y)===document.querySelector('#graph-svg canvas'),p))continue;await page.mouse.move(p.x,p.y);try{await expect(page.locator('#graph-svg')).toHaveAttribute('data-hovered-node','false',{timeout:500});return p;}catch{}}throw Error('No actual background point');}
