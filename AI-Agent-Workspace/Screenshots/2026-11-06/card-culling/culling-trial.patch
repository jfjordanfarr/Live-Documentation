+  test.setTimeout(90_000);
+  await openFit(page, "/", CHAIN_REPOSITORY);
+  // A symbol's name that appears once in the page, in a card the browser skipped. `window.find`, the page's find as a
+  // script can drive it, misses many names on or off the frame whatever the skipping (a name its word seams break at a
+  // hyphen or an underscore, 2026-11-06: 127 of the first 400 names found on this scope both with and without culling),
+  // so the name is one with no seam in it.
+  const target = await page.evaluate(() => {
+    const texts = [...document.querySelectorAll<HTMLElement>("#map-container .node-card .symbol-label-text")];
+    const count = (text: string): number => document.body.textContent!.split(text).length - 1;
+    for (const label of texts) {
+      const card = label.closest<HTMLElement>(".node-card")!;
+      const text = label.textContent!.trim();
+      if (text.length >= 6 && !label.children.length && card.firstElementChild && !card.firstElementChild.checkVisibility({ contentVisibilityAuto: true }) && count(text) === 1) return { id: card.dataset.id!, text };
+    }
+    return null;
+  });
+  expect(target, "a uniquely named symbol in a skipped card").not.toBeNull();
+  const found = await page.evaluate(({ id, text }) => {
+    getSelection()!.removeAllRanges();
+    const hit = (window as unknown as { find(text: string): boolean }).find(text);
+    const node = getSelection()!.anchorNode;
+    return { hit, inCard: !!node && !!(node.nodeType === Node.ELEMENT_NODE ? node as Element : node.parentElement)?.closest(`.node-card[data-id="${CSS.escape(id)}"]`) };
+  }, target!);
+  expect(found).toEqual({ hit: true, inCard: true });
