--- /dev/null
+++ b/packages/explorer/src/client/views/localView/card-culling.test.ts
@@ -0,0 +1,67 @@
+import { describe, expect, it } from "vitest";
+
+import { CARD_OVERHANG, CULL_LEAD, cardsOutside, drawnRegion, type PictureBox } from "./card-culling";
+
+/** A 1,000 × 600 frame whose top left corner stands at (200, 100) on screen. */
+const frame = { left: 200, top: 100, right: 1200, bottom: 700 };
+/** The lead in screen pixels for that frame: a quarter of its larger side. */
+const lead = CULL_LEAD * 1000;
+
+describe("drawnRegion", () => {
+  it("maps the frame, widened by the lead on screen, back through the camera, then widens it by the overhang", () => {
+    // The picture's origin stands at the frame's corner at scale 1: the region is the frame in the picture's pixels.
+    expect(drawnRegion(frame, { left: 200, top: 100 }, 1)).toEqual({
+      left: -lead - CARD_OVERHANG, top: -lead - CARD_OVERHANG, right: 1000 + lead + CARD_OVERHANG, bottom: 600 + lead + CARD_OVERHANG
+    });
+    // Panned so that the origin stands 300 px left of and 50 px above the frame's corner, at half scale: the frame
+    // shows picture pixels 600 to 2,600 across and 100 to 1,300 down; the lead is halved by the scale, the overhang not.
+    expect(drawnRegion(frame, { left: -100, top: 50 }, 0.5)).toEqual({
+      left: (300 - lead) / 0.5 - CARD_OVERHANG, top: (50 - lead) / 0.5 - CARD_OVERHANG,
+      right: (1300 + lead) / 0.5 + CARD_OVERHANG, bottom: (650 + lead) / 0.5 + CARD_OVERHANG
+    });
+  });
+
+  it("leads by the larger side of the frame on both axes, so a phone's tall frame leads as far across as down", () => {
+    const tall = drawnRegion({ left: 0, top: 0, right: 390, bottom: 844 }, { left: 0, top: 0 }, 1);
+    expect(tall.left).toBe(-CULL_LEAD * 844 - CARD_OVERHANG);
+    expect(tall.top).toBe(-CULL_LEAD * 844 - CARD_OVERHANG);
+  });
+
+  it("draws everything for a scale that cannot place the picture", () => {
+    for (const scale of [0, -1, Number.NaN, Number.POSITIVE_INFINITY]) {
+      const region = drawnRegion(frame, { left: 0, top: 0 }, scale);
+      expect(cardsOutside([{ id: "far", left: 1e9, top: 1e9, width: 1, height: 1 }], region).size).toBe(0);
+    }
+  });
+});
+
+describe("cardsOutside", () => {
+  const region = { left: 0, top: 0, right: 1000, bottom: 600 };
+  const box = (id: string, left: number, top: number, width = 200, height = 100): PictureBox => ({ id, left, top, width, height });
+
+  it("names only the cards whose boxes miss the region entirely", () => {
+    const outside = cardsOutside([
+      box("inside", 100, 100),
+      box("across the left edge", -150, 100),
+      box("across the bottom edge", 400, 550),
+      box("taller than the region, from above it", 400, -500, 200, 2000),
+      box("left of it", -300, 100),
+      box("right of it", 1001, 100),
+      box("above it", 100, -101),
+      box("below it", 100, 601)
+    ], region);
+    expect([...outside].sort()).toEqual(["above it", "below it", "left of it", "right of it"]);
+  });
+
+  it("keeps a card whose box only touches the region's edge", () => {
+    expect(cardsOutside([box("touching the left", -200, 0), box("touching the bottom", 0, 600)], region).size).toBe(0);
+  });
+
+  it("keeps a card near the frame drawn, by the overhang, so that its halo and grown dots are never cut at the edge", () => {
+    // A card whose box ends 40 px left of the frame at scale 1 shows its halo and shadow inside it: the overhang keeps it.
+    const near = drawnRegion({ left: 0, top: 0, right: 1000, bottom: 600 }, { left: 0, top: 0 }, 1);
+    const card = box("just left of the frame", -lead - 240, 100);
+    expect(cardsOutside([card], near).size).toBe(0);
+    expect(cardsOutside([{ ...card, left: -lead - CARD_OVERHANG - 201 }], near).size).toBe(1);
+  });
+});
