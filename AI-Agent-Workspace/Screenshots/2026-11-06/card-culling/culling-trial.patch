index 00000000..85493689
--- /dev/null
+++ b/packages/explorer/src/client/views/localView/card-culling.ts
@@ -0,0 +1,66 @@
+/**
+ * Which of the 2D Local Map's cards stand outside the frame, so that the browser may skip their style, layout and paint
+ * (`content-visibility: auto`) while keeping their boxes (2026-11-06, Turns 13 to 16 of the November 5 record: "Such
+ * invariants should present possibilities for speedup, at least conceptually, no?"). A card's box depends on its
+ * structure alone, never on zoom (the architectural decision "A Card's Box Never Depends on Zoom"), so the boxes the
+ * layout placed say where every card is at any camera without asking the page.
+ *
+ * Pure: the frame and the picture's origin come in as numbers, and what comes out is a set of card ids.
+ *
+ * @module card-culling
+ */
+
+/** An axis-aligned region, in whichever coordinates its caller states. */
+export interface Region {
+  left: number;
+  top: number;
+  right: number;
+  bottom: number;
+}
+
+/** A card's box where the pose stands it, in the picture's own pixels. */
+export interface PictureBox {
+  id: string;
+  left: number;
+  top: number;
+  width: number;
+  height: number;
+}
+
+/**
+ * How far past its box a card is drawn, in the picture's pixels: the test-backed halo (8 px out, with a 24 px shadow
+ * 12 px down), the subject's glow (30 px with 12 px down), the hubs 6 px out and the anchor dots grown from their edge
+ * at the far steps. A card whose box lies within this of the frame may still show a part, so it is never skipped.
+ */
+export const CARD_OVERHANG = 64;
+
+/**
+ * How far past the frame on screen a card is still drawn, as a share of the frame's larger side: the cards a pan or a
+ * zoom is about to bring in are drawn before they arrive, so that the frame that brings them does not draw them all.
+ */
+export const CULL_LEAD = 0.25;
+
+/**
+ * The region of the picture, in its own pixels, whose cards must be drawn: the frame on screen widened by
+ * {@link CULL_LEAD}, mapped back through the camera (the picture's origin on screen and its scale), then widened by
+ * {@link CARD_OVERHANG}. A scale that is not a positive finite number draws everything.
+ */
+export function drawnRegion(frame: Region, origin: { left: number; top: number }, scale: number): Region {
+  if (!(scale > 0) || !Number.isFinite(scale)) return { left: -Infinity, top: -Infinity, right: Infinity, bottom: Infinity };
+  const lead = CULL_LEAD * Math.max(frame.right - frame.left, frame.bottom - frame.top);
+  return {
+    left: (frame.left - lead - origin.left) / scale - CARD_OVERHANG,
+    top: (frame.top - lead - origin.top) / scale - CARD_OVERHANG,
+    right: (frame.right + lead - origin.left) / scale + CARD_OVERHANG,
+    bottom: (frame.bottom + lead - origin.top) / scale + CARD_OVERHANG
+  };
+}
+
+/** The ids of the cards whose boxes do not meet the region; a box that touches its edge meets it. */
+export function cardsOutside(boxes: Iterable<PictureBox>, region: Region): Set<string> {
+  const outside = new Set<string>();
+  for (const box of boxes) {
+    if (box.left + box.width < region.left || box.left > region.right || box.top + box.height < region.top || box.top > region.bottom) outside.add(box.id);
+  }
+  return outside;
+}
