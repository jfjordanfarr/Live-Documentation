+import { expect, test, type Page } from "@playwright/test";
+
+import { CHAIN_ESTATE, CHAIN_REPOSITORY } from "./scopes";
+import { localMapStill, localRetainUrl } from "./still-picture";
+
+/**
+ * Culling of the 2D Local Map's cards (2026-11-06, Turns 13 to 16 of the November 5 record): a card the frame does not
+ * show is marked `local-card-offscreen`, and the browser may skip its style, layout and paint (`content-visibility:
+ * auto`) while it keeps its box by the height the layout measured. A card's box depends on its structure alone, never
+ * on what is drawn, so skipping must move nothing; a skipped card must stay reachable by the keyboard and by the
+ * page's find; and a card on screen is never skippable, since the containment would change how it is drawn.
+ */
+
+const SKIPPABLE = "local-card-offscreen";
+
+interface CardState {
+  id: string;
+  width: number;
+  height: number;
+  /** The card's place in the picture's pixels, from the picture's root, the camera's scale taken out. */
+  left: number;
+  top: number;
+  skippable: boolean;
+  /** The browser skipped the card's contents: its first child is not drawn for `content-visibility: auto`. */
+  skipped: boolean;
+  /** Some part of the card's box is inside the map's frame on screen. */
+  onScreen: boolean;
+}
+
+const cards = (page: Page): Promise<CardState[]> => page.evaluate(() => {
+  const root = document.querySelector<HTMLElement>("#map-container .local-placed")!;
+  const origin = root.getBoundingClientRect();
+  const view = document.querySelector<HTMLElement>("#view-map")!.getBoundingClientRect();
+  const k = new DOMMatrix(getComputedStyle(document.querySelector("#map-viewport")!).transform).a;
+  return [...document.querySelectorAll<HTMLElement>("#map-container .node-card")].map(card => {
+    const rect = card.getBoundingClientRect();
+    return {
+      id: card.dataset.id!, width: card.offsetWidth, height: card.offsetHeight,
+      left: Math.round((rect.left - origin.left) / k * 100) / 100, top: Math.round((rect.top - origin.top) / k * 100) / 100,
+      skippable: card.classList.contains("local-card-offscreen"),
+      skipped: !!card.firstElementChild && !card.firstElementChild.checkVisibility({ contentVisibilityAuto: true }),
+      onScreen: rect.right > view.left && rect.left < view.right && rect.bottom > view.top && rect.top < view.bottom
+    };
+  }).sort((a, b) => a.id.localeCompare(b.id));
+});
+
+/** Two frames, in which the browser decides which marked cards it skips. */
+const frames = (page: Page): Promise<void> => page.evaluate(() => new Promise<void>(resolve => requestAnimationFrame(() => requestAnimationFrame(() => resolve()))));
+
+const boxes = (states: CardState[]) => states.map(({ id, width, height, left, top }) => ({ id, width, height, left, top }));
+
+/** Every card drawn, as without culling: the marks taken off in place, until the next camera change puts them back. */
+const drawAll = (page: Page): Promise<void> => page.evaluate(name => {
+  for (const card of document.querySelectorAll("#map-container .node-card")) card.classList.remove(name);
+}, SKIPPABLE);
+
+const press = async (page: Page, name: "Zoom In" | "Zoom Out" | "Reset Zoom", times = 1): Promise<void> => {
+  for (let index = 0; index < times; index++) {
+    await page.getByRole("button", { name, exact: true }).click();
+    await localMapStill(page);
+  }
+  await frames(page);
+};
+
+/** A retained scope's picture at its fit, where most of its cards are off the frame. */
+async function openFit(page: Page, base: string, files: readonly string[]): Promise<void> {
+  await page.setViewportSize({ width: 1440, height: 960 });
+  await page.goto(localRetainUrl(base, files));
+  await page.locator(`.node-card[data-id="${files[0]}"]`).waitFor();
+  await localMapStill(page);
+  await frames(page);
+}
+
+for (const [bundle, base, files] of [["repository", "/", CHAIN_REPOSITORY], ["estate", "/samples/estate/", CHAIN_ESTATE]] as const) {
+  test(`${bundle} chain: skipping a card off the frame moves no card, at any camera, and never skips one on screen`, async ({ page }) => {
+    test.setTimeout(90_000);
+    await openFit(page, base, files);
+    let skippedSomewhere = 0;
+    const check = async (moment: string): Promise<CardState[]> => {
+      const on = await cards(page);
+      for (const card of on) {
+        expect(card.skippable && card.onScreen, `${moment}: ${card.id} is on screen and skippable`).toBe(false);
+        expect(card.skipped && !card.skippable, `${moment}: ${card.id} is skipped unmarked`).toBe(false);
+      }
+      skippedSomewhere = Math.max(skippedSomewhere, on.filter(card => card.skipped).length);
+      await drawAll(page);
+      await frames(page);
+      const off = await cards(page);
+      expect(off.every(card => !card.skipped), `${moment}: every card drawn once unmarked`).toBe(true);
+      expect(boxes(off), `${moment}: the boxes with skipping off`).toEqual(boxes(on));
+      return on;
+    };
+    const fit = boxes(await check("the fit"));
+    await press(page, "Zoom In", 4);
+    expect(boxes(await check("close up"))).toEqual(fit);
+    await press(page, "Reset Zoom");
+    await press(page, "Zoom Out", 6);
+    expect(boxes(await check("far out"))).toEqual(fit);
+    // The test proves nothing unless the browser skipped cards somewhere on the way.
+    expect(skippedSomewhere, "cards skipped at the closest camera").toBeGreaterThan(0);
+  });
+
+  test(`${bundle} chain: a picture measured again while cards are skipped measures every card as drawn`, async ({ page }) => {
+    test.setTimeout(90_000);
+    await openFit(page, base, files);
+    const before = boxes(await cards(page));
+    await press(page, "Zoom In", 4);
+    expect((await cards(page)).filter(card => card.skipped).length, "cards skipped before the window changes").toBeGreaterThan(0);
+    // A change of the window's width measures the cards again in place (the card reading's resize), with the cards off
+    // the frame skipped until then: their widths and heights must come from their contents, as at the first picture.
+    await page.setViewportSize({ width: 1180, height: 960 });
+    await localMapStill(page);
+    await page.setViewportSize({ width: 1440, height: 960 });
+    await localMapStill(page);
+    await frames(page);
+    const after = await cards(page);
+    expect(after.map(({ id, width, height }) => ({ id, width, height }))).toEqual(before.map(({ id, width, height }) => ({ id, width, height })));
+  });
+}
+
+test("Tab into a card off the frame brings it on screen and draws it", async ({ page }) => {
+  test.setTimeout(90_000);
+  // At the fit most of the retained scope's cards are off the frame (some 260 of the first 400 names are in skipped cards).
+  await openFit(page, "/", CHAIN_REPOSITORY);
+  // From the subject's name, Tab through the cards' commands until the focus enters a card that was skipped.
+  await page.locator(`.node-card[data-id="${CHAIN_REPOSITORY[0]}"] .local-file-name`).focus();
+  let entered: string | null = null;
+  for (let index = 0; index < 400 && !entered; index++) {
+    const skipped = new Set((await cards(page)).filter(card => card.skipped).map(card => card.id));
+    await page.keyboard.press("Tab");
+    await page.waitForTimeout(60);
+    const id = await page.evaluate(() => (document.activeElement?.closest(".node-card") as HTMLElement | null)?.dataset.id ?? null);
+    if (id && skipped.has(id)) entered = id;
