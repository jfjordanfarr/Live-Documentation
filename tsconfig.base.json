{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
  "moduleResolution": "Node",
  "baseUrl": ".",
    "lib": ["ES2022"],
  "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    "outDir": "dist",
    "paths": {
      "@live-documentation/engine/*": ["packages/engine/src/*"],
      "@live-documentation/scripts/*": ["packages/scripts/src/*"],
      "@live-documentation/generator/*": ["packages/generator/src/*"]
    }
  },
  "references": [
    { "path": "packages/engine" },
    { "path": "packages/generator" },
    { "path": "packages/scripts" }
  ]
}
